from collections.abc import Callable, Iterable, Iterator, Mapping, MutableMapping, Sequence
from typing import Any, ClassVar, Self, TypeVar

from .pointer import JsonPointer as JsonPointer, JsonPointerException as JsonPointerException

__version__: str
__license__: str
__jsonpatch_version__: str

_T = TypeVar("_T")
_K = TypeVar("_K")
_V = TypeVar("_V")

# An operation such as {"op": "add", "path": "/a", "value": 1}
_Operation = Mapping[str, Any]
_Dumps = Callable[[Any], str]
_Loads = Callable[[Any], Any]

class JsonPatchException(Exception): ...
class InvalidJsonPatch(JsonPatchException): ...
class JsonPatchConflict(JsonPatchException): ...
class JsonPatchTestFailed(JsonPatchException, AssertionError): ...

def multidict(ordered_pairs: Iterable[tuple[_K, _V]]) -> dict[_K, _V | list[_V]]: ...
def apply_patch(
    doc: Any,
    patch: str | bytes | Sequence[_Operation],
    in_place: bool = False,
    pointer_cls: type[JsonPointer] = ...,
) -> Any: ...
def make_patch(src: Any, dst: Any, pointer_cls: type[JsonPointer] = ...) -> JsonPatch: ...
def deepcopy(x: _T) -> _T: ...

class PatchOperation:
    pointer_cls: type[JsonPointer]
    location: str
    pointer: JsonPointer
    operation: MutableMapping[str, Any]
    def __init__(self, operation: MutableMapping[str, Any], pointer_cls: type[JsonPointer] = ...) -> None: ...
    def apply(self, obj: Any) -> Any: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    @property
    def path(self) -> str: ...
    @property
    def key(self) -> int | str: ...
    @key.setter
    def key(self, value: object) -> None: ...
    def get_part(self, index: int) -> int | str: ...
    def set_part(self, index: int, value: object) -> None: ...

class RemoveOperation(PatchOperation): ...
class AddOperation(PatchOperation): ...
class ReplaceOperation(PatchOperation): ...

class MoveOperation(PatchOperation):
    @property
    def from_path(self) -> str: ...
    @property
    def from_key(self) -> int | str: ...
    @from_key.setter
    def from_key(self, value: object) -> None: ...
    def get_from_part(self, index: int) -> int | str: ...
    def set_from_part(self, index: int, value: object) -> None: ...

class TestOperation(PatchOperation): ...
class CopyOperation(PatchOperation): ...

class JsonPatch:
    operations: ClassVar[Mapping[str, type[PatchOperation]]]
    patch: Sequence[_Operation]
    pointer_cls: type[JsonPointer]
    json_dumper: ClassVar[Callable[..., str]]
    json_loader: ClassVar[Callable[..., Any]]
    def __init__(self, patch: Sequence[_Operation], pointer_cls: type[JsonPointer] = ...) -> None: ...
    def __bool__(self) -> bool: ...
    def __nonzero__(self) -> bool: ...
    def __iter__(self) -> Iterator[_Operation]: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    @classmethod
    def from_string(
        cls, patch_str: str | bytes | bytearray, loads: _Loads | None = None, pointer_cls: type[JsonPointer] = ...
    ) -> Self: ...
    @classmethod
    def from_diff(
        cls,
        src: Any,
        dst: Any,
        optimization: bool = True,
        dumps: _Dumps | None = None,
        pointer_cls: type[JsonPointer] = ...,
    ) -> Self: ...
    def to_string(self, dumps: _Dumps | None = None) -> str: ...
    def apply(self, obj: Any, in_place: bool = False) -> Any: ...

class DiffBuilder:
    dumps: _Dumps
    pointer_cls: type[JsonPointer]
    index_storage: list[dict[Any, list[Any]]]
    src_doc: Any
    dst_doc: Any
    arrays: dict[Any, Any]
    def __init__(self, src_doc: Any, dst_doc: Any, dumps: _Dumps = ..., pointer_cls: type[JsonPointer] = ...) -> None: ...
    def store_index(self, value: Any, index: Any, st: int) -> None: ...
    def take_index(self, value: Any, st: int) -> Any: ...
    def insert(self, op: Any) -> list[Any]: ...
    def remove(self, index: list[Any]) -> None: ...
    def __iter__(self) -> Iterator[Any]: ...
    def execute(self) -> Iterator[dict[str, Any]]: ...
