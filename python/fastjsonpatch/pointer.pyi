from collections.abc import Iterable, Iterator
from typing import Any, Self

__author__: str
__license__: str
__jsonpointer_version__: str
VERBOSE_EXCEPTIONS: bool

def set_pointer(doc: Any, pointer: str, value: Any, inplace: bool = True) -> Any: ...
def resolve_pointer(doc: Any, pointer: str, default: Any = ...) -> Any: ...
def pairwise(iterable: Iterable[Any]) -> Iterator[tuple[Any, Any]]: ...
def escape(s: str) -> str: ...
def unescape(s: str) -> str: ...

class JsonPointerException(Exception): ...

class EndOfList:
    list_: Any
    def __init__(self, list_: Any) -> None: ...

class JsonPointer:
    parts: list[str]
    def __init__(self, pointer: str) -> None: ...
    def to_last(self, doc: Any) -> tuple[Any, Any]: ...
    def resolve(self, doc: Any, default: Any = ...) -> Any: ...
    get = resolve
    def set(self, doc: Any, value: Any, inplace: bool = True) -> Any: ...
    @classmethod
    def get_part(cls, doc: Any, part: str) -> Any: ...
    def get_parts(self) -> list[str]: ...
    def walk(self, doc: Any, part: str) -> Any: ...
    def contains(self, ptr: JsonPointer) -> bool: ...
    def __contains__(self, item: JsonPointer) -> bool: ...
    def join(self, suffix: JsonPointer | str | Iterable[Any]) -> Self: ...
    def __truediv__(self, suffix: JsonPointer | str | Iterable[Any]) -> Self: ...
    @property
    def path(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    @classmethod
    def from_parts(cls, parts: Iterable[Any]) -> Self: ...
